# Copy to .env (git-ignored). Values below are local-dev placeholders only.
DJANGO_SECRET_KEY=dev-only-change-me
DJANGO_DEBUG=1
# Schools live at <subdomain>.<BASE_DOMAIN>
BASE_DOMAIN=localhost

DB_HOST=localhost
DB_PORT=5432
DB_NAME=schools
DB_SUPERUSER_PASSWORD=dev-superuser
# Table owner: runs migrations (DB_ROLE=owner). Subject to RLS too (not a superuser).
DB_OWNER_USER=schools_owner
DB_OWNER_PASSWORD=dev-owner
# NOBYPASSRLS role the web process uses (DB_ROLE=app, the default).
DB_APP_USER=schools_app
DB_APP_PASSWORD=dev-app

# __Host- cookie prefix and Secure flag need https. Local dev is plain http, so turn them off here.
# Accepts only 1/true/0/false; "false" is refused unless DJANGO_DEBUG=1. Leave unset (true) elsewhere.
SECURE_COOKIES=false

# Behind Cloudflare (production): trust its X-Forwarded-Proto, and read the client address from
# CF-Connecting-IP (rate limits). Leave both unset locally.
# TRUST_PROXY_HTTPS=true
# CLIENT_IP_HEADER=HTTP_CF_CONNECTING_IP

# Traces: set an OTLP endpoint (the Alloy collector) to export; unset, tracing is off.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_SERVICE_NAME=schools-api
