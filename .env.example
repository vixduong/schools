# Copy to .env (git-ignored). Values below are local-dev placeholders only.
DJANGO_SECRET_KEY=dev-only-change-me
DJANGO_DEBUG=1
# Schools live at <subdomain>.<BASE_DOMAIN>
BASE_DOMAIN=localhost

DB_HOST=localhost
DB_PORT=5432
DB_NAME=schools
DB_SUPERUSER_PASSWORD=dev-superuser
# Table owner: runs migrations (DB_ROLE=owner). Subject to RLS too (not a superuser).
DB_OWNER_USER=schools_owner
DB_OWNER_PASSWORD=dev-owner
# NOBYPASSRLS role the web process uses (DB_ROLE=app, the default).
DB_APP_USER=schools_app
DB_APP_PASSWORD=dev-app
