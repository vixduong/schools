#!/bin/sh
# Fast checks on the staged files only (seconds); `make check` runs the full suite with the database.
set -e
cd "$(git rev-parse --show-toplevel)"
py=$(git diff --cached --name-only --diff-filter=ACMR -- 'backend/*.py' | sed 's#^backend/##')
if [ -n "$py" ]; then
  (cd backend && uv run ruff check --force-exclude $py && uv run ruff format --check --force-exclude $py)
fi
if git diff --cached --name-only --diff-filter=ACMR | grep -q '^frontend/'; then
  pnpm --dir frontend lint && pnpm --dir frontend typecheck
fi
